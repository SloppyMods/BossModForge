<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>BossModForge</AssemblyName>
    <RootNamespace>BossModForge.Plugin</RootNamespace>
    <Version>0.5.0.0</Version>
    <Description>Generate BossMod modules from replay recordings</Description>
    <Authors>BossModForge</Authors>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <OutputPath>$(AppData)\XIVLauncher\devPlugins\BossModForge\</OutputPath>
    <DalamudPackagerEnabled>false</DalamudPackagerEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Required to build this Windows-TFM project on Linux; no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Linux/Wine (xlcore): build straight into the local devPlugins folder. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <OutputPath>$(HOME)/.xlcore/devPlugins/BossModForge/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BossModForge.Core\BossModForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\flavors\*.json" Link="flavors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="BossModForge.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToDevPlugins" AfterTargets="Build">
    <PropertyGroup>
      <DevPluginsPath Condition="'$(OS)' == 'Windows_NT'">$(AppData)\XIVLauncher\devPlugins\BossModForge\</DevPluginsPath>
      <DevPluginsPath Condition="'$(OS)' != 'Windows_NT'">$(HOME)/.xlcore/devPlugins/BossModForge/</DevPluginsPath>
    </PropertyGroup>
    <MakeDir Directories="$(DevPluginsPath)" Condition="!Exists('$(DevPluginsPath)')" />
    <MakeDir Directories="$(DevPluginsPath)flavors" Condition="!Exists('$(DevPluginsPath)flavors')" />
    <!-- VERIFY-9: transitive JsonSchema.Net DLLs; copy every output DLL rather than naming them. -->
    <ItemGroup>
      <_ForgeDlls Include="$(OutputPath)*.dll" />
      <_ForgeFlavors Include="$(OutputPath)flavors\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ForgeDlls)" DestinationFolder="$(DevPluginsPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BossModForge.json" DestinationFiles="$(DevPluginsPath)BossModForge.json" />
    <Copy SourceFiles="@(_ForgeFlavors)" DestinationFolder="$(DevPluginsPath)flavors" SkipUnchangedFiles="true" />
  </Target>
</Project>
